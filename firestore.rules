rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return verified() && request.auth.token.email.lower() == "aaz52468599@gmail.com";
    }
    function approved() {
      return verified() && (admin() ||
        (exists(/databases/$(database)/documents/access/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/access/$(request.auth.uid)).data.status == "approved"));
    }
    function owner(uid) { return approved() && request.auth.uid == uid; }
    function number(value) { return value is int || value is float; }
    function portfolioViewer(uid) {
      return approved() && exists(/databases/$(database)/documents/sharedPortfolios/$(uid)) &&
        request.auth.uid in get(/databases/$(database)/documents/sharedPortfolios/$(uid)).data.viewerUids;
    }
    function strategyViewer(uid) {
      return approved() && exists(/databases/$(database)/documents/strategyAccess/$(uid)) &&
        request.auth.uid in get(/databases/$(database)/documents/strategyAccess/$(uid)).data.viewerUids;
    }
    function validAsset(assetId) {
      let a = request.resource.data;
      return a.id == assetId && a.name is string && a.name.size() > 0 && a.name.size() <= 80 &&
        a.mode in ["manual", "crypto", "tw", "stock", "usd"] &&
        (a.mode != "manual" || (number(a.value) && a.value >= 0)) &&
        (a.mode == "manual" || (number(a.qty) && a.qty > 0));
    }

    match /users/{uid} {
      allow read, create: if owner(uid);
      // A legacy app cannot replace a migrated profile with an older array snapshot.
      allow update: if owner(uid) &&
        (!("schemaVersion" in resource.data) || resource.data.schemaVersion != 2 || request.resource.data.schemaVersion == 2);
      allow delete: if false;
      match /assets/{assetId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validAsset(assetId);
      }
      match /history/{date} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.date == date &&
          date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") && number(request.resource.data.total) && request.resource.data.total >= 0;
      }
      match /backups/{backupId} {
        allow read, create: if owner(uid);
        allow update, delete: if false;
      }
    }

    match /access/{uid} {
      allow read: if verified() && (request.auth.uid == uid || admin());
      allow create: if verified() && request.auth.uid == uid && request.resource.data.status == "pending" &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.keys().hasOnly(["email", "name", "status", "requestedAt"]);
      allow update, delete: if admin();
    }

    match /sharedPortfolios/{uid} {
      allow read: if approved() && (request.auth.uid == uid || request.auth.uid in resource.data.viewerUids);
      allow create, update: if owner(uid) &&
        request.resource.data.keys().hasOnly(["ownerName", "viewerUids", "assets", "updatedAt"]) &&
        request.resource.data.ownerName is string && request.resource.data.viewerUids is list &&
        request.resource.data.viewerUids.size() <= 20 && request.resource.data.assets is list && request.resource.data.assets.size() <= 100;
      allow delete: if owner(uid);
    }
    match /strategyAccess/{uid} {
      allow read: if approved() && (request.auth.uid == uid || request.auth.uid in resource.data.viewerUids);
      allow create, update: if owner(uid) &&
        request.resource.data.keys().hasOnly(["ownerName", "viewerUids", "updatedAt"]) &&
        request.resource.data.ownerName is string && request.resource.data.viewerUids is list && request.resource.data.viewerUids.size() <= 20;
      allow delete: if owner(uid);
    }

    match /strategies/{uid}/posts/{postId} {
      allow read: if owner(uid) || (strategyViewer(uid) && resource.data.published == true);
      allow create, update: if owner(uid) && request.resource.data.id == postId && request.resource.data.ownerUid == uid &&
        request.resource.data.keys().hasOnly(["id", "ownerUid", "ownerName", "title", "symbol", "term", "thesis", "entry", "invalidation", "target", "status", "published", "createdAt", "updatedAt"]) &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
        request.resource.data.symbol is string && request.resource.data.symbol.size() > 0 && request.resource.data.symbol.size() <= 80 &&
        request.resource.data.thesis is string && request.resource.data.thesis.size() > 0 && request.resource.data.thesis.size() <= 4000 &&
        request.resource.data.term in ["long", "short"] && request.resource.data.status in ["watching", "active", "closed"] &&
        request.resource.data.published is bool;
      allow delete: if owner(uid);
    }

    // Additive review data: existing strategy documents and their rules are unchanged.
    function reviewPost(uid,postId) { return get(/databases/$(database)/documents/strategies/$(uid)/posts/$(postId)).data; }
    function reviewReaders(uid,postId) { return owner(uid) || (strategyViewer(uid) && reviewPost(uid,postId).published == true); }
    function reviewHead(uid,postId) { return get(/databases/$(database)/documents/strategyReviews/$(uid)/posts/$(postId)).data; }
    function reviewAudience(uid) { return get(/databases/$(database)/documents/strategyAccess/$(uid)).data.viewerUids; }
    function liveRound(uid,postId,roundId,r) {
      return reviewHead(uid,postId).roundId == roundId && reviewPost(uid,postId).published == true &&
        r.strategyUpdatedAt == reviewPost(uid,postId).updatedAt && r.voterUids.hasOnly(reviewAudience(uid)) &&
        r.adoptedMs == 0 && request.time.toMillis() < r.deadlineMs;
    }
    match /strategyReviews/{uid}/posts/{postId} {
      allow read: if reviewReaders(uid,postId);
      allow create, update: if owner(uid) && reviewPost(uid,postId).published == true &&
        request.resource.data.keys().hasOnly(['roundId','strategyUpdatedAt']) &&
        request.resource.data.roundId is string && request.resource.data.roundId.size() > 0 &&
        request.resource.data.strategyUpdatedAt == reviewPost(uid,postId).updatedAt &&
        !exists(/databases/$(database)/documents/strategyReviews/$(uid)/posts/$(postId)/rounds/$(request.resource.data.roundId)) &&
        getAfter(/databases/$(database)/documents/strategyReviews/$(uid)/posts/$(postId)/rounds/$(request.resource.data.roundId)).data.strategyUpdatedAt == request.resource.data.strategyUpdatedAt;
      allow delete: if false;
      match /rounds/{roundId} {
        allow read: if reviewReaders(uid,postId);
        allow create: if owner(uid) && reviewPost(uid,postId).published == true &&
          request.resource.data.keys().hasOnly(['roundId','strategyUpdatedAt','voterUids','deadlineMs','createdMs','choices','reasons','adoptedMs']) &&
          request.resource.data.roundId == roundId &&
          getAfter(/databases/$(database)/documents/strategyReviews/$(uid)/posts/$(postId)).data.roundId == roundId &&
          request.resource.data.strategyUpdatedAt == reviewPost(uid,postId).updatedAt &&
          request.resource.data.voterUids is list && request.resource.data.voterUids.size() > 0 && request.resource.data.voterUids.size() <= 20 &&
          request.resource.data.voterUids.toSet().size() == request.resource.data.voterUids.size() &&
          !(uid in request.resource.data.voterUids) && request.resource.data.voterUids.hasOnly(reviewAudience(uid)) &&
          number(request.resource.data.deadlineMs) && request.resource.data.deadlineMs > request.time.toMillis() &&
          request.resource.data.deadlineMs <= request.time.toMillis() + 2592000000 &&
          number(request.resource.data.createdMs) && request.resource.data.createdMs > request.time.toMillis() - 300000 &&
          request.resource.data.createdMs <= request.time.toMillis() + 120000 &&
          request.resource.data.choices == {} && request.resource.data.reasons == {} && request.resource.data.adoptedMs == 0;
        allow update: if reviewReaders(uid,postId) && liveRound(uid,postId,roundId,resource.data) && (
          (request.auth.uid in resource.data.voterUids &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choices','reasons']) &&
           request.resource.data.choices is map && request.resource.data.reasons is map &&
           request.resource.data.choices.diff(resource.data.choices).affectedKeys().hasOnly([request.auth.uid]) &&
           request.resource.data.reasons.diff(resource.data.reasons).affectedKeys().hasOnly([request.auth.uid]) &&
           request.resource.data.choices[request.auth.uid] in ['agree','reject'] &&
           request.resource.data.reasons[request.auth.uid] is string && request.resource.data.reasons[request.auth.uid].size() <= 500 &&
           (request.resource.data.choices[request.auth.uid] == 'agree' || request.resource.data.reasons[request.auth.uid].size() > 0)) ||
          (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adoptedMs']) &&
           resource.data.choices.keys().hasAll(resource.data.voterUids) && resource.data.choices.values().hasOnly(['agree']) &&
           number(request.resource.data.adoptedMs) && request.resource.data.adoptedMs > request.time.toMillis() - 300000 &&
           request.resource.data.adoptedMs <= request.time.toMillis() + 120000)
        );
        allow delete: if false;
      }
    }

    match /shareInvites/{inviteId} {
      allow read: if approved() && (resource.data.ownerUid == request.auth.uid || resource.data.recipientEmail == request.auth.token.email.lower());
      allow create: if approved() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(["ownerUid", "ownerName", "recipientEmail", "status", "createdAt"]) &&
        request.resource.data.status == "pending" && request.resource.data.ownerName is string &&
        request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.size() <= 254 &&
        request.resource.data.recipientEmail != request.auth.token.email.lower();
      // A recipient can accept their own invitation, but cannot modify who owns it or who was invited.
      allow update: if approved() && resource.data.status == "pending" &&
        resource.data.recipientEmail == request.auth.token.email.lower() &&
        request.resource.data.status == "accepted" && request.resource.data.viewerUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "viewerUid", "acceptedAt"]);
      allow delete: if approved() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
