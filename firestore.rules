rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return verified() && request.auth.token.email.lower() == "aaz52468599@gmail.com";
    }
    function approved() {
      return verified() && (admin() ||
        (exists(/databases/$(database)/documents/access/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/access/$(request.auth.uid)).data.status == "approved"));
    }
    function owner(uid) { return approved() && request.auth.uid == uid; }
    function number(value) { return value is int || value is float; }
    function portfolioViewer(uid) {
      return approved() && exists(/databases/$(database)/documents/sharedPortfolios/$(uid)) &&
        request.auth.uid in get(/databases/$(database)/documents/sharedPortfolios/$(uid)).data.viewerUids;
    }
    function strategyViewer(uid) {
      return approved() && exists(/databases/$(database)/documents/strategyAccess/$(uid)) &&
        request.auth.uid in get(/databases/$(database)/documents/strategyAccess/$(uid)).data.viewerUids;
    }
    function strategyPost(uid, postId) {
      let selected = /databases/$(database)/documents/selectedStrategies/$(uid)/posts/$(postId);
      return exists(selected) ? get(selected).data : get(/databases/$(database)/documents/strategies/$(uid)/posts/$(postId)).data;
    }
    function postViewer(uid, postId) {
      let post = strategyPost(uid, postId);
      return strategyViewer(uid) && post.published == true &&
        (!("viewerUids" in post) || request.auth.uid in post.viewerUids);
    }
    function validCompletion(c) {
      return c is map && c.keys().hasAll(["outcome", "amount", "currency", "closedOn", "note"]) &&
        c.keys().hasOnly(["outcome", "amount", "currency", "closedOn", "note"]) &&
        c.outcome in ["profit", "loss", "flat"] && c.currency in ["TWD", "USD"] &&
        (c.amount == null || (number(c.amount) && c.amount >= 0 && c.amount <= 9007199254740991)) &&
        (c.outcome == "flat" ? c.amount == 0 : (c.amount == null || c.amount > 0)) &&
        c.closedOn is string && c.closedOn.matches("^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$") &&
        c.note is string && c.note.size() <= 1000;
    }
    function preserveStrategyDetails() {
      return request.method != "update" ||
        ((!('holdingPeriod' in resource.data) || 'holdingPeriod' in request.resource.data) &&
         (!('completion' in resource.data) || 'completion' in request.resource.data));
    }
    function validStrategy(uid, postId, selected) {
      let p = request.resource.data;
      return p.id == postId && p.ownerUid == uid &&
        p.keys().hasOnly(["id", "ownerUid", "ownerName", "title", "symbol", "term", "thesis", "entry", "invalidation", "target", "holdingPeriod", "completion", "status", "published", "createdAt", "updatedAt"].concat(selected ? ["audienceUids", "viewerUids"] : [])) &&
        p.title is string && p.title.size() > 0 && p.title.size() <= 100 &&
        p.symbol is string && p.symbol.size() > 0 && p.symbol.size() <= 80 &&
        p.thesis is string && p.thesis.size() > 0 && p.thesis.size() <= 4000 &&
        p.term in ["long", "short"] && p.status in ["watching", "active", "closed"] && p.published is bool &&
        p.get("holdingPeriod", "") is string && p.get("holdingPeriod", "").size() <= 200 &&
        (!("completion" in p) || (p.status == "closed" && validCompletion(p.completion))) &&
        preserveStrategyDetails();
    }
    function validAsset(assetId) {
      let a = request.resource.data;
      return a.id == assetId && a.name is string && a.name.size() > 0 && a.name.size() <= 80 &&
        a.mode in ["manual", "crypto", "tw", "stock", "usd"] &&
        (a.mode != "manual" || (number(a.value) && a.value >= 0)) &&
        (a.mode == "manual" || (number(a.qty) && a.qty > 0));
    }

    match /users/{uid} {
      allow read, create: if owner(uid);
      // A legacy app cannot replace a migrated profile with an older array snapshot.
      allow update: if owner(uid) &&
        (!("schemaVersion" in resource.data) || resource.data.schemaVersion != 2 || request.resource.data.schemaVersion == 2);
      allow delete: if false;
      match /assets/{assetId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validAsset(assetId);
      }
      match /history/{date} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.date == date &&
          date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") && number(request.resource.data.total) && request.resource.data.total >= 0;
      }
      match /backups/{backupId} {
        allow read, create: if owner(uid);
        allow update, delete: if false;
      }
    }

    match /access/{uid} {
      allow read: if verified() && (request.auth.uid == uid || admin());
      allow create: if verified() && request.auth.uid == uid && request.resource.data.status == "pending" &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.keys().hasOnly(["email", "name", "status", "requestedAt"]);
      allow update, delete: if admin();
    }

    match /sharedPortfolios/{uid} {
      allow read: if approved() && (request.auth.uid == uid || request.auth.uid in resource.data.viewerUids);
      allow create, update: if owner(uid) &&
        request.resource.data.keys().hasOnly(["ownerName", "viewerUids", "assets", "updatedAt"]) &&
        request.resource.data.ownerName is string && request.resource.data.viewerUids is list &&
        request.resource.data.viewerUids.size() <= 20 && request.resource.data.assets is list && request.resource.data.assets.size() <= 100;
      allow delete: if owner(uid);
    }
    match /strategyAccess/{uid} {
      allow read: if approved() && (request.auth.uid == uid || request.auth.uid in resource.data.viewerUids);
      allow create, update: if owner(uid) &&
        request.resource.data.keys().hasOnly(["ownerName", "viewerUids", "updatedAt"]) &&
        request.resource.data.ownerName is string && request.resource.data.viewerUids is list && request.resource.data.viewerUids.size() <= 20;
      allow delete: if owner(uid);
    }

    match /strategies/{uid}/posts/{postId} {
      allow read: if owner(uid) || (strategyViewer(uid) && resource.data.published == true);
      allow create, update: if owner(uid) && validStrategy(uid, postId, false) &&
        !exists(/databases/$(database)/documents/selectedStrategies/$(uid)/posts/$(postId));
      allow delete: if owner(uid);
    }

    match /selectedStrategies/{uid}/posts/{postId} {
      // A single array query needs no composite index. Private drafts have an
      // empty viewerUids array; audienceUids preserves the owner's selections.
      allow list: if owner(uid) || (strategyViewer(uid) && request.auth.uid in resource.data.viewerUids);
      allow get: if owner(uid) || (strategyViewer(uid) &&
        (!exists(/databases/$(database)/documents/selectedStrategies/$(uid)/posts/$(postId)) || request.auth.uid in resource.data.viewerUids));
      allow create, update: if owner(uid) && validStrategy(uid, postId, true) &&
        !existsAfter(/databases/$(database)/documents/strategies/$(uid)/posts/$(postId)) &&
        request.resource.data.audienceUids is list && request.resource.data.audienceUids.size() <= 20 &&
        request.resource.data.audienceUids.toSet().size() == request.resource.data.audienceUids.size() &&
        !(uid in request.resource.data.audienceUids) &&
        (request.resource.data.audienceUids.size() == 0 || request.resource.data.audienceUids.toSet().hasOnly(get(/databases/$(database)/documents/strategyAccess/$(uid)).data.viewerUids)) &&
        request.resource.data.viewerUids == (request.resource.data.published ? request.resource.data.audienceUids : []) &&
        request.resource.data.updatedAt is string;
      allow delete: if owner(uid);
    }

    match /strategyParticipation/{uid}/posts/{postId}/members/{memberUid} {
      function participationReader() {
        return owner(uid) || (approved() && postViewer(uid, postId));
      }
      function validParticipation() {
        return request.resource.data.keys().hasOnly(["choice", "strategyUpdatedAt", "displayName", "photoURL", "updatedAt"]) &&
          request.resource.data.keys().hasAll(["choice", "strategyUpdatedAt", "displayName", "photoURL", "updatedAt"]) &&
          request.resource.data.choice in ["participating", "not-participating"] &&
          request.resource.data.strategyUpdatedAt == strategyPost(uid, postId).updatedAt &&
          request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80 &&
          request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500 &&
          request.resource.data.updatedAt is string;
      }
      allow read: if participationReader();
      allow create, update: if participationReader() && request.auth.uid == memberUid && validParticipation();
      allow delete: if false;
    }

    match /strategyReads/{uid}/posts/{postId}/members/{memberUid} {
      allow read: if owner(uid) || (approved() && request.auth.uid == memberUid && postViewer(uid, postId));
      allow create, update: if approved() && request.auth.uid == memberUid &&
        (owner(uid) || postViewer(uid, postId)) && strategyPost(uid, postId).published == true &&
        request.resource.data.keys().hasOnly(["strategyUpdatedAt", "displayName", "photoURL", "readAt"]) &&
        request.resource.data.strategyUpdatedAt == strategyPost(uid, postId).updatedAt &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80 &&
        request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500 &&
        request.resource.data.readAt is string;
      allow delete: if false;
    }

    match /shareInvites/{inviteId} {
      allow read: if approved() && (resource.data.ownerUid == request.auth.uid || resource.data.recipientEmail == request.auth.token.email.lower());
      allow create: if approved() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(["ownerUid", "ownerName", "recipientEmail", "status", "createdAt"]) &&
        request.resource.data.status == "pending" && request.resource.data.ownerName is string &&
        request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.size() <= 254 &&
        request.resource.data.recipientEmail != request.auth.token.email.lower();
      // A recipient can accept their own invitation, but cannot modify who owns it or who was invited.
      allow update: if approved() && resource.data.status == "pending" &&
        resource.data.recipientEmail == request.auth.token.email.lower() &&
        request.resource.data.status == "accepted" && request.resource.data.viewerUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "viewerUid", "acceptedAt"]);
      allow delete: if approved() && resource.data.ownerUid == request.auth.uid;
    }
  }
}

